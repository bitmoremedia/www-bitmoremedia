---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/clients/*.png', {
  eager: true,
})

// [file, name, x, y, width] in px from the design, so desktop matches its loose arrangement exactly
const layout: [string, string, number, number, number][] = [
  ['virgin-money', 'Virgin Money', 178, 9, 237.7],
  ['accenture', 'Accenture', 539.5, 6, 394.5],
  ['currys', 'Currys', 940.4, 5, 274.1],
  ['pret', 'Pret A Manger', 1288.7, 0, 242.8],
  ['blackrock', 'BlackRock', 214.5, 140.7, 264.6],
  ['sky', 'Sky', 1055.5, 150, 114.5],
  ['bny', 'BNY', 184.1, 238.4, 272.1],
  ['pwc', 'PwC', 516.5, 186, 249.4],
  ['bt', 'BT', 880.5, 229, 143.4],
  ['nandos', 'Nando’s', 1303.7, 170, 213.9],
  ['rsa', 'RSA', 147.5, 368, 277.2],
  ['ey', 'EY', 595.5, 384, 70],
  ['bupa', 'Bupa', 933.5, 380, 220.2],
  ['mcdonalds', 'McDonald’s', 1323.2, 373, 157.3],
]

const rem = (px: number) => `${px / 16}rem`
const clients = layout.map(([file, name, x, y, w]) => ({
  name,
  logo: logoFiles[`../assets/clients/${file}.png`].default,
  style: `--x: ${rem(x)}; --y: ${rem(y)}; --w: ${rem(w)}`,
}))
---

<section
  id="clients"
  class="bg-cyan pt-16 pb-16 text-blue-ink sm:pt-20 xl:pt-[8.6875rem] xl:pb-[7.75rem]"
>
  <div class="container-site">
    <h2 class="text-[2rem] leading-[1.371] font-heavy xl:text-d35">Our clients</h2>
    <p class="mt-3 max-w-[30.125rem] text-base tracking-snug leading-[1.35] sm:text-lg xl:mt-[2.1875rem] xl:text-d20">
      We’ve had the privilege of working with a wide range of clients – from ambitious startups to
      established organisations – helping each one define, elevate and express their brand with
      clarity and impact.
    </p>
  </div>

  <ul class="container-site mt-12 grid grid-cols-3 items-center gap-x-6 gap-y-10 sm:grid-cols-4 xl:relative xl:mt-[4.375rem] xl:block xl:h-[31.6875rem] xl:px-0">
    {clients.map((client) => (
      <li
        class="flex h-14 items-center justify-center xl:absolute xl:top-(--y) xl:left-(--x) xl:block xl:h-auto xl:w-(--w)"
        style={client.style}
      >
        <Image
          src={client.logo}
          alt={client.name}
          widths={[240, 480, 720]}
          sizes="(min-width: 80rem) 15rem, 25vw"
          class="max-h-full w-auto max-w-full object-contain xl:max-h-none xl:w-full"
        />
      </li>
    ))}
  </ul>
</section>
