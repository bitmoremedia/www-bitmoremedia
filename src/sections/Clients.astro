---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

import SectionHeading from '../components/SectionHeading.astro'

// Logos are cut from the design PDF for now – swap for proper SVGs (see FOLLOW-UPS.md)
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('../assets/clients/*.png', {
  eager: true,
})

const clients = [
  ['accenture', 'Accenture'],
  ['currys', 'Currys'],
  ['pret', 'Pret A Manger'],
  ['virgin-money', 'Virgin Money'],
  ['blackrock', 'BlackRock'],
  ['sky', 'Sky'],
  ['bny', 'BNY'],
  ['pwc', 'PwC'],
  ['bt', 'BT'],
  ['nandos', 'Nando’s'],
  ['rsa', 'RSA'],
  ['ey', 'EY'],
  ['bupa', 'Bupa'],
  ['mcdonalds', 'McDonald’s'],
].map(([file, name]) => ({ name, logo: logoFiles[`../assets/clients/${file}.png`].default }))
---

<section id="clients" class="bg-cyan py-20 lg:py-28">
  <div class="container-site">
    <SectionHeading text="Our clients" dot="blue" />
    <p class="mt-6 max-w-2xl text-lg leading-relaxed">
      We’ve had the privilege of working with a wide range of clients – from ambitious startups to
      established organisations – helping each one define, elevate and express their brand with
      clarity and impact.
    </p>

    <ul class="mt-14 grid grid-cols-3 items-center gap-x-6 gap-y-12 lg:grid-cols-5 lg:gap-y-16">
      {clients.map((client) => (
        <li class="flex h-10 items-center justify-center lg:h-12">
          <Image
            src={client.logo}
            alt={client.name}
            height={112}
            class="max-h-full w-auto max-w-full object-contain lg:max-w-40"
          />
        </li>
      ))}
    </ul>
  </div>
</section>
