---
import { Image } from 'astro:assets'

import Dot from '../components/Dot.astro'
import curious from '../assets/home/curious.png'
import clear from '../assets/home/clear.png'
import clever from '../assets/home/clever.png'

/*
 * Illustrations hang off the bottom of each card. `image` is the illustration's position and
 * width inside the coloured area, in rem at the desktop design size.
 */
const values = [
  {
    name: 'Curious',
    text: '…reflects our creativity, energy, and a sense of exploration – which pairs naturally with vibrant visuals.',
    card: 'bg-yellow text-orange-ink',
    title: 'text-blue',
    dots: 'bg-blue',
    src: curious,
    alt: 'A ladybird on a curling plant tendril',
    image: 'xl:left-[6.875rem] xl:top-[18.5rem] xl:w-[20.8125rem]',
  },
  {
    name: 'Clear',
    text: '…balances the boldness with a promise of simplicity and coherence – reassuring for clients navigating branding.',
    card: 'bg-orange-strong text-white',
    title: 'text-white',
    dots: 'bg-white',
    src: clear,
    alt: 'A glossy silver droplet',
    image: 'xl:left-[7.03rem] xl:top-[17.75rem] xl:w-[19.125rem]',
  },
  {
    name: 'Clever',
    text: '… brings in our strategic edge and smart thinking – showing there’s substance behind the style.',
    card: 'bg-cyan text-orange-ink-cyan',
    title: 'text-blue-ink',
    dots: 'bg-blue',
    src: clever,
    alt: 'A pink 3D brain',
    image: 'xl:left-[10.125rem] xl:top-[17.875rem] xl:w-[17.5625rem]',
  },
]
---

<section
  id="who-we-are"
  class="overflow-x-clip bg-mint pt-16 pb-16 text-orange-ink sm:pt-20 xl:pt-[8.5rem] xl:pb-[9.1875rem]"
>
  <div class="container-site">
    <h2 class="text-[2.75rem] leading-[0.833] font-heavy xl:text-d60">
      Who we are
      <Dot colour="bg-blue" class="relative -top-[0.283em] ml-[0.28em] size-[0.483em]" />
    </h2>
    <h3 class="mt-8 text-2xl font-heavy xl:mt-[3.1875rem] xl:text-d35">Our story</h3>
    <div class="mt-4 max-w-measure space-y-[1.35em] text-base leading-[1.35] sm:text-lg xl:mt-[2.8125rem] xl:text-d20">
      <p>
        Bit More Media started with a simple idea: make branding feel less overwhelming and more
        you. No jargon, just clever thinking, creative execution, and tools that work. We’re a
        two-person studio with big ideas and high standards. That means when you work with us,
        you’re working directly with the people doing the thinking, the designing and the building –
        no middle layers, no confusion.
      </p>
      <p>
        We stay small on purpose, so every project gets our full attention and every brand we build
        feels personal. From branding and web development to social media and events, we get to the
        heart of what makes you different and help your audience see it too.
      </p>
      <p>
        Over the years, we’ve also built a trusted network of exceptional specialists we can bring
        into projects when needed. Every person has been carefully handpicked through years of
        collaboration, refining a group we know delivers outstanding work and shares our standards,
        values and approach.
      </p>
    </div>
  </div>

  <!-- Edge-to-edge cards whose white borders overlap, as in the design -->
  <ul class="mx-auto mt-14 flex max-w-[calc(var(--container-design)+1.25rem)] flex-col gap-4 px-5 md:flex-row md:gap-0 md:px-0 xl:mt-[6.375rem]">
    {values.map((value, i) => (
      <li
        class:list={[
          'flex-1 rounded-[1.25rem] bg-white p-[0.625rem] md:p-[1.25rem]',
          i > 0 && 'md:-ml-[1.375rem]',
        ]}
      >
        <div
          class:list={[
            'relative flex h-full flex-col rounded-[0.625rem] px-6 pt-8 md:px-[min(4.5rem,8%)] xl:h-[29.125rem] xl:px-[4.5rem] xl:pt-[2.5625rem]',
            value.card,
          ]}
        >
          <h3
            class:list={[
              'flex items-baseline justify-center text-[2.25rem] leading-[1.2] font-heavy xl:text-d50',
              value.title,
            ]}
          >
            {value.name}
            <span class="ml-[0.18em] flex gap-[0.04em]" aria-hidden="true">
              <Dot colour={value.dots} class="size-[0.36em]" />
              <Dot colour={value.dots} class="size-[0.36em]" />
              <Dot colour={value.dots} class="size-[0.36em]" />
            </span>
          </h3>
          <p class="mt-6 max-w-[25.125rem] text-lg leading-[1.36] font-heavy xl:mt-[2.9375rem] xl:text-d25">
            {value.text}
          </p>
          <Image
            src={value.src}
            alt={value.alt}
            widths={[320, 640]}
            sizes="(min-width: 80rem) 21rem, (min-width: 48rem) 28vw, 60vw"
            class:list={[
              'mx-auto -mb-10 mt-6 w-3/5 max-w-80 xl:absolute xl:m-0 xl:max-w-none',
              value.image,
            ]}
          />
        </div>
      </li>
    ))}
  </ul>

  <div class="container-site mt-20 xl:mt-[8.5rem]">
    <a
      href="/branding-hub/"
      class="inline-flex min-h-14 items-center rounded-xl bg-orange-strong px-6 text-lg text-white transition hover:-translate-y-0.5 hover:shadow-lg xl:-ml-[2.25rem] xl:h-[5.125rem] xl:min-w-[35.375rem] xl:px-[2.25rem] xl:whitespace-nowrap xl:text-d25"
    >
      This is our brand. But what could yours be?
    </a>
  </div>
</section>
