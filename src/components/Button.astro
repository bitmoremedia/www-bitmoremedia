---
interface Props {
  href: string
  variant?: 'orange' | 'navy'
  size?: 'md' | 'sm'
  class?: string
}

const { href, variant = 'orange', size = 'md', class: className } = Astro.props

const variants = {
  orange: 'bg-orange text-navy hover:bg-navy hover:text-white',
  navy: 'bg-navy text-white hover:bg-blue',
}

const sizes = {
  md: 'px-7 py-3.5 text-base',
  sm: 'px-6 py-2.5 text-sm',
}
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center rounded-full font-display font-black whitespace-nowrap transition-colors',
    variants[variant],
    sizes[size],
    className,
  ]}
>
  <slot />
</a>
