---
interface Props {
  href: string
  variant?: 'orange' | 'white'
  class?: string
}

const { href, variant = 'orange', class: className } = Astro.props

const variants = {
  orange: 'bg-orange-strong text-white',
  white: 'bg-white text-coral-ink',
}
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-12 items-center justify-center rounded-xl px-6 py-2 text-center text-lg leading-tight font-black transition hover:-translate-y-0.5 hover:shadow-lg xl:min-h-[3.875rem] xl:px-[2.25rem] xl:text-d25',
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
