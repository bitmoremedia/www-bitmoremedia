---
import Button from './Button.astro'

interface Props {
  title: string
}

const { title } = Astro.props
---

<section class="bg-yellow py-24 text-coral-ink xl:py-[10rem]">
  <div class="container-site max-w-[60rem]">
    <h1 class="text-[2.75rem] leading-none font-heavy xl:text-d65">
      {title}
      <span class="text-blue">.</span>
    </h1>
    <div class="mt-8 space-y-4 text-lg leading-[1.35] font-medium text-coral-deep-ink xl:text-d22">
      <slot />
    </div>
    <div class="mt-10 flex flex-wrap gap-4">
      <Button href="/">Back to home</Button>
    </div>
  </div>
</section>
