---
import Dot from './Dot.astro'
import type { DotColour } from '../data/site'

interface Props {
  text: string
  dot: DotColour
  as?: 'h1' | 'h2'
  class?: string
}

const { text, dot, as: Tag = 'h2', class: className } = Astro.props

// Keep the dot glued to the last word so it never wraps onto its own line
const words = text.split(' ')
const lastWord = words.pop()
---

<Tag class:list={['text-5xl font-black tracking-tight sm:text-6xl', className]}>
  {words.length > 0 && `${words.join(' ')} `}
  <!-- prettier-ignore -->
  <span class="whitespace-nowrap">{lastWord}<Dot colour={dot} class="relative -top-[0.1em] ml-[0.08em] size-[0.17em]" /></span>
</Tag>
