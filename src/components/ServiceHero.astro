---
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'

interface Props {
  title: string
  // Colour classes from the page's design
  titleColour: string
  textColour: string
  frameColour: string
  image: ImageMetadata
  alt: string
  // Width of the intro text box in the design, so lines break in the same places
  introWidth: string
  // Section height on desktop, which sets where the page content below starts
  height: string
  // Desktop top padding; the designs place each page's title slightly differently
  top?: string
}

const {
  title,
  titleColour,
  textColour,
  frameColour,
  image,
  alt,
  introWidth,
  height,
  top = 'xl:pt-[9.125rem]',
} = Astro.props
---

<section class:list={['pt-10 pb-14 sm:pt-16 xl:pb-0', top, height]}>
  <div class="container-site xl:relative">
    <h1 class:list={['text-[2.75rem] leading-[0.77] font-heavy xl:text-d65', titleColour]}>
      <span class="block">The</span> <span class="block">{title}</span>
    </h1>
    <div
      class:list={[
        'mt-6 space-y-[1.364em] text-lg leading-[1.364] tracking-pop xl:mt-[1.8125rem] xl:text-d22',
        introWidth,
        textColour,
      ]}
    >
      <slot />
    </div>

    <!-- Framed photo that runs off the right-hand edge of the page -->
    <div
      class:list={[
        'mt-10 rounded-[1.5625rem] p-3 sm:p-[1.3125rem] xl:absolute xl:-top-[1.375rem] xl:right-[calc(50%-50vw)] xl:left-[60.1875rem] xl:mt-0 xl:h-[23.9375rem] xl:rounded-r-none xl:pr-0',
        frameColour,
      ]}
    >
      <Image
        src={image}
        alt={alt}
        widths={[600, 900, 1400]}
        sizes="(min-width: 80rem) 46rem, 100vw"
        loading="eager"
        class="aspect-[730/342] w-full rounded-[0.625rem] object-cover xl:aspect-auto xl:h-full xl:rounded-r-none"
      />
    </div>
  </div>
</section>
